<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Store distribution requires the sandbox. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- No apple-events exception is needed: sleep is triggered by sending the
         kAESleep power event to the system process (see sleepTheMac()), which
         targets no scriptable app and works inside the sandbox. -->

</dict>
</plist>
